{
  "name": "poppyseed-inspector",
  "private": true,
  "type": "module",
  "description": "A protocol debugger: runs a real Personal Agent against your Poppyseed site and shows every request.",
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings --watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types --no-warnings server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "poppyseed": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "oidc-login": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0"
  }
}
